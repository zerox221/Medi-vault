# Environment Configuration Example for MediVault Backend
# Copy this file to .env and insert your real credentials.

# Application
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# Primary Database (MongoDB)
# MongoDB is the primary database for user profiles, medical records, access requests, activities, and audit logs.
MONGODB_URI=mongodb://127.0.0.1:27017/medivault

# Neon PostgreSQL Vector Store (pgvector)
# Set to 'postgres' to use Neon PostgreSQL with pgvector for 3072-dimensional Gemini embeddings & similarity search.
VECTOR_STORE=postgres
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-subdomain.us-east-2.aws.neon.tech/neondb?sslmode=require
PGVECTOR_DIMENSIONS=3072

# Optional: MongoDB Atlas Vector Search configuration
# Set to 'true' ONLY if connecting to MongoDB Atlas cloud and an Atlas Vector Search index is defined.
# If false (default), MediVault executes exact in-engine cosine similarity directly over MongoDB candidate chunks.
USE_ATLAS_VECTOR_SEARCH=false
ATLAS_VECTOR_INDEX_NAME=vector_index

# Authentication / Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_key_here

# Google Gemini AI Configuration (For Medical RAG, Embeddings & Clinical Q&A)
GEMINI_API_KEY=
AI_API_KEY=
AI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# RAG Engine Configuration
RAG_CHUNK_SIZE=450
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25
RAG_MAX_CONTEXT_TOKENS=3000
RAG_MAX_ANSWER_TOKENS=600

# File Upload & OCR Configuration
MAX_FILE_SIZE_MB=20
OCR_ENABLED=true
OCR_LANGUAGE=eng

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MediVault
BREVO_SMTP_USER=

# Cloudinary Private Medical Document Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial Administrator Seed Credentials
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session Expirations
QR_SESSION_EXPIRY_MINUTES=10
DEFAULT_SHARE_EXPIRY_HOURS=24
